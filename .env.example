# Copy to `fieldmap/.env` and fill in the two secrets.
#
# Supabase: the same project and the same anon key the app and admin panel use.
# That is safe here for the same reason it is safe there — the `field_*` tables
# grant nothing to `anon`, so this key on its own cannot read a single row. Only
# a signed-in account listed in `public.field_members` can.
VITE_SUPABASE_URL=https://xzvopqygmnletodqtnid.supabase.co
VITE_SUPABASE_ANON_KEY=paste_your_anon_key_here

# Mapbox *public* token (starts with `pk.`), from
# https://account.mapbox.com/access-tokens/
# Free up to 50,000 map loads a month. A public token is designed to ship in a
# browser bundle; restrict it by URL in the Mapbox dashboard once deployed.
# Never put a secret token (`sk.`) here.
VITE_MAPBOX_TOKEN=paste_your_mapbox_public_token_here
